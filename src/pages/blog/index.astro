---
import Layout from "../../components/Layout.astro";

interface BlogPost {
  slug: string;
  title: string;
  description: string;
  date: string;
  tags: string[];
}

const posts: BlogPost[] = [
  { slug: "how-many-plants-per-room", title: "How Many Plants Do You Need to Clean a Room's Air?", description: "The real math behind NASA's findings: plant count, room size, and what actually makes a measurable difference.", date: "2026-06-12", tags: ["Science", "Guide"] },
  { slug: "air-purifier-vs-plants", title: "Air Purifier vs. Plants: Which One Actually Works Better?", description: "A detailed comparison of HEPA filters, activated carbon, and living plants — and why the best approach uses both.", date: "2026-06-02", tags: ["Comparison"] },
  { slug: "do-plants-really-clean-air", title: "Do Indoor Plants Really Clean the Air? What Science Says", description: "Separating the 1989 NASA claims from 2020s real-world studies. Spoiler: plants work, but not how you think.", date: "2026-05-18", tags: ["Science", "Myth"] },
  { slug: "mold-on-houseplant-soil", title: "White Mold on Indoor Plant Soil: Causes and Simple Fixes", description: "That fuzzy white stuff on your plant's soil isn't always bad. Learn what causes it, when to worry, and how to fix it.", date: "2026-05-03", tags: ["Care", "Troubleshooting"] },
];
---
<Layout
  title="Plant Care Blog & Air Quality Guides"
  description="Expert articles on indoor plants and air quality. Care guides, science explainers, and practical tips for a healthier home with plants."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-20">
    <header class="mb-12">
      <p class="text-xs font-semibold uppercase tracking-wider text-green-600 mb-3">Articles & Guides</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tighter text-stone-900 mb-4">Blog</h1>
      <p class="text-base text-stone-500 leading-relaxed">Science-backed articles on indoor air quality and plant care.</p>
    </header>

    <div class="space-y-6">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group block bg-white rounded-xl border border-stone-200/60 p-6 hover:border-green-200 hover:shadow-md hover:shadow-green-50/30 transition-all duration-300">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <time datetime={post.date} class="text-xs text-stone-400">{new Date(post.date).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</time>
            {post.tags.map((tag) => (
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-green-50 text-green-700">{tag}</span>
            ))}
          </div>
          <h2 class="text-lg font-semibold text-stone-800 group-hover:text-green-700 transition-colors mb-1.5">{post.title}</h2>
          <p class="text-sm text-stone-500 leading-relaxed">{post.description}</p>
        </a>
      ))}
    </div>
  </div>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": posts.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Article",
      "headline": p.title,
      "description": p.description,
      "datePublished": p.date,
      "url": "https://best-indoor-plants-for-air-quality.com/blog/" + p.slug,
      "author": { "@type": "Organization", "name": "Air Purifying Plants Guide" },
      "publisher": { "@type": "Organization", "name": "Air Purifying Plants Guide", "url": "https://best-indoor-plants-for-air-quality.com" }
    }
  }))
})} />
</Layout>
